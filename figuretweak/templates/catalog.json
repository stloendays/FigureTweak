{
 "purposes": [
  ["compare", "比较几组的大小"],
  ["rank", "排序与名次变化"],
  ["compose", "组成与拆解"],
  ["distribution", "分布与离散"],
  ["relation", "两个量的关系"],
  ["trend", "随条件变化的趋势"],
  ["uncertainty", "估计值与区间"],
  ["catalysis", "催化与反应"]
 ],
 "templates": [
  {"id": "bar", "name": "柱状图 + 误差棒", "purpose": "compare", "size": [89, 62],
   "when": "几种催化剂或条件的一个量对比；同一类有多次测量时自动画均值 ± s.d. 和每个点。",
   "data": "一列类别、一列数值，可选一列误差。",
   "fields": [["X", "类别", "text"], ["Y", "数值", "number"], ["ERR", "误差（可不选）", "number?"],
              ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["SORT", "排序", "choice:none=原顺序,ascending=从小到大,descending=从大到小"],
              ["HIGHLIGHT_ITEM", "突出显示的一类（红色）", "value:X"]]},
  {"id": "grouped_bar", "name": "分组柱状图", "purpose": "compare", "size": [120, 66],
   "when": "两个因素交叉的比较，比如每种催化剂在三个温度下的产率。",
   "data": "一列类别、一列分组、一列数值，可选一列误差。",
   "fields": [["X", "类别（横轴）", "text"], ["GROUP", "分组（颜色）", "text"], ["Y", "数值", "number"],
              ["ERR", "误差（可不选）", "number?"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["LEGEND_TITLE", "图例标题", "label"]]},
  {"id": "stacked_bar", "name": "堆叠柱状图", "purpose": "compose", "size": [100, 62],
   "when": "总量由几部分组成，比如每种工艺的成本构成；可切换成百分比或横向。",
   "data": "一列类别、一列组成部分、一列数值。",
   "fields": [["X", "类别", "text"], ["PART", "组成部分（颜色）", "text"], ["Y", "数值", "number"],
              ["PERCENT", "换算成百分比", "bool"], ["HORIZONTAL", "横向", "bool"],
              ["XLABEL", "类别轴标题", "label"], ["YLABEL", "数值轴标题", "label"], ["SHOW_TOTAL", "标出总量", "bool"]]},
  {"id": "waterfall", "name": "瀑布图（成本拆解）", "purpose": "compose", "size": [110, 64],
   "when": "从一个起点总量逐项加减到终点，比如两种工艺的成本差拆成几项。",
   "data": "第一行是起点总量，之后每行一个增减项。",
   "fields": [["STEP", "项目名", "text"], ["CHANGE", "起点值 / 增减量", "number"],
              ["END_NAME", "终点名称", "label"], ["XLABEL", "数值轴标题", "label"]]},
  {"id": "lollipop", "name": "排序棒棒糖图", "purpose": "rank", "size": [89, 62],
   "when": "很多项按一个分数排名，突出其中一项；比柱状图更省墨、标签更好读。",
   "data": "一列名称、一列数值。",
   "fields": [["LABEL", "名称", "text"], ["VALUE", "数值", "number"], ["DESCENDING", "大的在上", "bool"],
              ["TOP_N", "只显示前几项（0 = 全部）", "int"], ["HIGHLIGHT_ITEM", "突出显示的一项", "value:LABEL"],
              ["XLABEL", "数值轴标题", "label"], ["SHOW_VALUES", "标出数值", "bool"]]},
  {"id": "slope", "name": "斜率图（名次变化）", "purpose": "rank", "size": [70, 70],
   "when": "同一批对象在两个指标下的名次或数值对比，看谁升谁降。",
   "data": "一列名称、左右两列名次（或数值）。",
   "fields": [["LABEL", "名称", "text"], ["LEFT", "左侧名次/数值", "number"], ["RIGHT", "右侧名次/数值", "number"],
              ["LEFT_NAME", "左侧标题", "label"], ["RIGHT_NAME", "右侧标题", "label"],
              ["RANKS", "按名次（1 在最上）", "bool"], ["HIGHLIGHT_ITEM", "突出显示的一项", "value:LABEL"]]},
  {"id": "dumbbell", "name": "哑铃图（前后对比）", "purpose": "compare", "size": [89, 62],
   "when": "每项有两个值（改进前后、两种工况），看差多少、往哪边变。",
   "data": "一列名称、两列数值。",
   "fields": [["LABEL", "名称", "text"], ["A", "第一个值（空心）", "number"], ["B", "第二个值（实心）", "number"],
              ["A_NAME", "第一个值的名称", "label"], ["B_NAME", "第二个值的名称", "label"],
              ["XLABEL", "数值轴标题", "label"], ["SORT_BY_CHANGE", "按变化量排序", "bool"]]},
  {"id": "box_points", "name": "箱线图 + 散点", "purpose": "distribution", "size": [89, 62],
   "when": "每组有多次测量，看中位数、四分位和每个点；样本少时比柱状图诚实。",
   "data": "一列分组、一列测量值（每行一次测量）。",
   "fields": [["GROUP", "分组", "text"], ["VALUE", "测量值", "number"], ["XLABEL", "横轴标题", "label"],
              ["YLABEL", "纵轴标题", "label"], ["SHOW_POINTS", "画出每个点", "bool"], ["SHOW_MEAN", "标出均值", "bool"]]},
  {"id": "violin", "name": "小提琴图", "purpose": "distribution", "size": [89, 62],
   "when": "每组样本较多，想看分布形状（双峰、偏态）。",
   "data": "一列分组、一列测量值（每行一次测量）。",
   "fields": [["GROUP", "分组", "text"], ["VALUE", "测量值", "number"], ["XLABEL", "横轴标题", "label"],
              ["YLABEL", "纵轴标题", "label"], ["SHOW_BOX", "内嵌箱线和中位数", "bool"]]},
  {"id": "histogram", "name": "直方图", "purpose": "distribution", "size": [89, 62],
   "when": "一个量的分布，比如蒙特卡洛抽样结果；可按组叠加比较。",
   "data": "一列数值，可选一列分组。",
   "fields": [["VALUE", "数值", "number"], ["GROUP", "分组（可不选）", "text?"], ["BINS", "分箱数", "int"],
              ["DENSITY", "画概率密度", "bool"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["SHOW_MEDIAN", "标出中位数", "bool"]]},
  {"id": "scatter_fit", "name": "散点 + 线性拟合", "purpose": "relation", "size": [89, 66],
   "when": "两个量的相关，比如描述符与活性（标度关系），自动给出斜率和 R²。",
   "data": "两列数值，可选一列分组。",
   "fields": [["X", "横轴数值", "number"], ["Y", "纵轴数值", "number"], ["GROUP", "分组（可不选）", "text?"],
              ["FIT", "拟合", "choice:linear=线性拟合,none=不拟合"], ["FIT_PER_GROUP", "每组单独拟合", "bool"],
              ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"]]},
  {"id": "parity", "name": "平价图（模型 vs 参考）", "purpose": "relation", "size": [72, 72],
   "when": "模型预测和参考值的一致性，y = x 对角线加 ±% 带，自动给出 MAPE 和 R²。",
   "data": "一列参考值、一列模型值，可选一列分组。",
   "fields": [["REF", "参考值（横轴）", "number"], ["PRED", "模型值（纵轴）", "number"], ["GROUP", "分组（可不选）", "text?"],
              ["BAND", "± 带宽（%，0 = 不画）", "float"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"]]},
  {"id": "line", "name": "折线图（多条曲线）", "purpose": "trend", "size": [100, 66],
   "when": "随温度、压力、时间等连续条件变化，几条曲线对比；可加误差带，可取对数轴。",
   "data": "一列横轴数值、一列纵轴数值，可选一列系列名和一列误差。",
   "fields": [["X", "横轴数值", "number"], ["Y", "纵轴数值", "number"], ["SERIES", "系列（可不选）", "text?"],
              ["ERR", "误差带（可不选）", "number?"], ["MARKERS", "画数据点", "bool"], ["LOG_X", "横轴取对数", "bool"],
              ["LOG_Y", "纵轴取对数", "bool"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["LABEL_ENDS", "在线尾标名称（代替图例）", "bool"]]},
  {"id": "heatmap", "name": "热图", "purpose": "compare", "size": [100, 62],
   "when": "两个因素网格上的一个量，比如助剂 × 载体的产率；可在格子里标数值。",
   "data": "一列行名、一列列名、一列数值（每格一行）。",
   "fields": [["ROW", "行", "text"], ["COL", "列", "text"], ["VALUE", "数值", "number"],
              ["CMAP", "配色", "choice:Blues=蓝,Greens=绿,Reds=红,viridis=viridis,RdBu_r=蓝白红"],
              ["SHOW_VALUES", "格子里标数值", "bool"], ["VALUE_FORMAT", "数值格式", "label"],
              ["COLORBAR_LABEL", "色条标题", "label"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"]]},
  {"id": "forest", "name": "森林图（估计值 + 区间）", "purpose": "uncertainty", "size": [120, 60],
   "when": "主结果和各个稳健性检验的估计值与置信区间放在一起看。",
   "data": "一列名称、一列估计值、两列区间上下限。",
   "fields": [["LABEL", "名称", "text"], ["EST", "估计值", "number"], ["LOW", "区间下限", "number"],
              ["HIGH", "区间上限", "number"], ["FIRST_IS_MAIN", "第一行是主结果（红色）", "bool"],
              ["XLABEL", "数值轴标题", "label"], ["SHOW_NUMBERS", "右侧写出数值", "bool"]]},
  {"id": "energy_profile", "name": "反应能垒图", "purpose": "catalysis", "size": [100, 66],
   "when": "反应路径上各中间态和过渡态的能量，几种表面或机理对比。",
   "data": "一列状态（按反应顺序）、一列能量，可选一列路径名。",
   "fields": [["STATE", "状态", "text"], ["ENERGY", "能量", "number"], ["PATHWAY", "路径（可不选）", "text?"],
              ["YLABEL", "纵轴标题", "label"], ["SHOW_VALUES", "标出每级能量", "bool"]]}
 ]
}
