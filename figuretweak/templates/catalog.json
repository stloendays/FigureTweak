{
 "purposes": [
  ["compare", "比较几组的大小"],
  ["rank", "排序与名次变化"],
  ["compose", "组成与拆解"],
  ["distribution", "分布与离散"],
  ["relation", "两个量的关系"],
  ["multivar", "多变量与多指标"],
  ["trend", "随条件变化的趋势"],
  ["uncertainty", "估计值与区间"],
  ["sets", "集合与交集"],
  ["catalysis", "催化与反应"]
 ],
 "templates": [
  {"id": "bar", "name": "柱状图 + 误差棒", "purpose": "compare", "size": [89, 62],
   "when": "几种催化剂或条件的一个量对比；同一类有多次测量时自动画均值 ± s.d. 和每个点。",
   "data": "一列类别、一列数值，可选一列误差。",
   "fields": [["X", "类别", "text"], ["Y", "数值", "number"], ["ERR", "误差（可不选）", "number?"],
              ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["SORT", "排序", "choice:none=原顺序,ascending=从小到大,descending=从大到小"],
              ["HIGHLIGHT_ITEM", "突出显示的一类（红色）", "value:X"]]},
  {"id": "grouped_bar", "name": "分组柱状图", "purpose": "compare", "size": [120, 66],
   "when": "两个因素交叉的比较，比如每种催化剂在三个温度下的产率。",
   "data": "一列类别、一列分组、一列数值，可选一列误差。",
   "fields": [["X", "类别（横轴）", "text"], ["GROUP", "分组（颜色）", "text"], ["Y", "数值", "number"],
              ["ERR", "误差（可不选）", "number?"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["LEGEND_TITLE", "图例标题", "label"]]},
  {"id": "stacked_bar", "name": "堆叠柱状图", "purpose": "compose", "size": [100, 62],
   "when": "总量由几部分组成，比如每种工艺的成本构成；可切换成百分比或横向。",
   "data": "一列类别、一列组成部分、一列数值。",
   "fields": [["X", "类别", "text"], ["PART", "组成部分（颜色）", "text"], ["Y", "数值", "number"],
              ["PERCENT", "换算成百分比", "bool"], ["HORIZONTAL", "横向", "bool"],
              ["XLABEL", "类别轴标题", "label"], ["YLABEL", "数值轴标题", "label"], ["SHOW_TOTAL", "标出总量", "bool"]]},
  {"id": "waterfall", "name": "瀑布图（成本拆解）", "purpose": "compose", "size": [110, 64],
   "when": "从一个起点总量逐项加减到终点，比如两种工艺的成本差拆成几项。",
   "data": "第一行是起点总量，之后每行一个增减项。",
   "fields": [["STEP", "项目名", "text"], ["CHANGE", "起点值 / 增减量", "number"],
              ["END_NAME", "终点名称", "label"], ["XLABEL", "数值轴标题", "label"]]},
  {"id": "lollipop", "name": "排序棒棒糖图", "purpose": "rank", "size": [89, 62],
   "when": "很多项按一个分数排名，突出其中一项；比柱状图更省墨、标签更好读。",
   "data": "一列名称、一列数值。",
   "fields": [["LABEL", "名称", "text"], ["VALUE", "数值", "number"], ["DESCENDING", "大的在上", "bool"],
              ["TOP_N", "只显示前几项（0 = 全部）", "int"], ["HIGHLIGHT_ITEM", "突出显示的一项", "value:LABEL"],
              ["XLABEL", "数值轴标题", "label"], ["SHOW_VALUES", "标出数值", "bool"]]},
  {"id": "slope", "name": "斜率图（名次变化）", "purpose": "rank", "size": [70, 70],
   "when": "同一批对象在两个指标下的名次或数值对比，看谁升谁降。",
   "data": "一列名称、左右两列名次（或数值）。",
   "fields": [["LABEL", "名称", "text"], ["LEFT", "左侧名次/数值", "number"], ["RIGHT", "右侧名次/数值", "number"],
              ["LEFT_NAME", "左侧标题", "label"], ["RIGHT_NAME", "右侧标题", "label"],
              ["RANKS", "按名次（1 在最上）", "bool"], ["HIGHLIGHT_ITEM", "突出显示的一项", "value:LABEL"]]},
  {"id": "dumbbell", "name": "哑铃图（前后对比）", "purpose": "compare", "size": [89, 62],
   "when": "每项有两个值（改进前后、两种工况），看差多少、往哪边变。",
   "data": "一列名称、两列数值。",
   "fields": [["LABEL", "名称", "text"], ["A", "第一个值（空心）", "number"], ["B", "第二个值（实心）", "number"],
              ["A_NAME", "第一个值的名称", "label"], ["B_NAME", "第二个值的名称", "label"],
              ["XLABEL", "数值轴标题", "label"], ["SORT_BY_CHANGE", "按变化量排序", "bool"]]},
  {"id": "box_points", "name": "箱线图 + 散点", "purpose": "distribution", "size": [89, 62],
   "when": "每组有多次测量，看中位数、四分位和每个点；样本少时比柱状图诚实。",
   "data": "一列分组、一列测量值（每行一次测量）。",
   "fields": [["GROUP", "分组", "text"], ["VALUE", "测量值", "number"], ["XLABEL", "横轴标题", "label"],
              ["YLABEL", "纵轴标题", "label"], ["SHOW_POINTS", "画出每个点", "bool"], ["SHOW_MEAN", "标出均值", "bool"]]},
  {"id": "violin", "name": "小提琴图", "purpose": "distribution", "size": [89, 62],
   "when": "每组样本较多，想看分布形状（双峰、偏态）。",
   "data": "一列分组、一列测量值（每行一次测量）。",
   "fields": [["GROUP", "分组", "text"], ["VALUE", "测量值", "number"], ["XLABEL", "横轴标题", "label"],
              ["YLABEL", "纵轴标题", "label"], ["SHOW_BOX", "内嵌箱线和中位数", "bool"]]},
  {"id": "histogram", "name": "直方图", "purpose": "distribution", "size": [89, 62],
   "when": "一个量的分布，比如蒙特卡洛抽样结果；可按组叠加比较。",
   "data": "一列数值，可选一列分组。",
   "fields": [["VALUE", "数值", "number"], ["GROUP", "分组（可不选）", "text?"], ["BINS", "分箱数", "int"],
              ["DENSITY", "画概率密度", "bool"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["SHOW_MEDIAN", "标出中位数", "bool"]]},
  {"id": "scatter_fit", "name": "散点 + 线性拟合", "purpose": "relation", "size": [89, 66],
   "when": "两个量的相关，比如描述符与活性（标度关系），自动给出斜率和 R²。",
   "data": "两列数值，可选一列分组。",
   "fields": [["X", "横轴数值", "number"], ["Y", "纵轴数值", "number"], ["GROUP", "分组（可不选）", "text?"],
              ["FIT", "拟合", "choice:linear=线性拟合,none=不拟合"], ["FIT_PER_GROUP", "每组单独拟合", "bool"],
              ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"]]},
  {"id": "parity", "name": "平价图（模型 vs 参考）", "purpose": "relation", "size": [72, 72],
   "when": "模型预测和参考值的一致性，y = x 对角线加 ±% 带，自动给出 MAPE 和 R²。",
   "data": "一列参考值、一列模型值，可选一列分组。",
   "fields": [["REF", "参考值（横轴）", "number"], ["PRED", "模型值（纵轴）", "number"], ["GROUP", "分组（可不选）", "text?"],
              ["BAND", "± 带宽（%，0 = 不画）", "float"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"]]},
  {"id": "line", "name": "折线图（多条曲线）", "purpose": "trend", "size": [100, 66],
   "when": "随温度、压力、时间等连续条件变化，几条曲线对比；可加误差带，可取对数轴。",
   "data": "一列横轴数值、一列纵轴数值，可选一列系列名和一列误差。",
   "fields": [["X", "横轴数值", "number"], ["Y", "纵轴数值", "number"], ["SERIES", "系列（可不选）", "text?"],
              ["ERR", "误差带（可不选）", "number?"], ["MARKERS", "画数据点", "bool"], ["LOG_X", "横轴取对数", "bool"],
              ["LOG_Y", "纵轴取对数", "bool"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["LABEL_ENDS", "在线尾标名称（代替图例）", "bool"]]},
  {"id": "heatmap", "name": "热图", "purpose": "compare", "size": [100, 62],
   "when": "两个因素网格上的一个量，比如助剂 × 载体的产率；可在格子里标数值。",
   "data": "一列行名、一列列名、一列数值（每格一行）。",
   "fields": [["ROW", "行", "text"], ["COL", "列", "text"], ["VALUE", "数值", "number"],
              ["CMAP", "配色", "choice:Blues=蓝,Greens=绿,Reds=红,viridis=viridis,RdBu_r=蓝白红"],
              ["SHOW_VALUES", "格子里标数值", "bool"], ["VALUE_FORMAT", "数值格式", "label"],
              ["COLORBAR_LABEL", "色条标题", "label"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"]]},
  {"id": "forest", "name": "森林图（估计值 + 区间）", "purpose": "uncertainty", "size": [120, 60],
   "when": "主结果和各个稳健性检验的估计值与置信区间放在一起看。",
   "data": "一列名称、一列估计值、两列区间上下限。",
   "fields": [["LABEL", "名称", "text"], ["EST", "估计值", "number"], ["LOW", "区间下限", "number"],
              ["HIGH", "区间上限", "number"], ["FIRST_IS_MAIN", "第一行是主结果（红色）", "bool"],
              ["XLABEL", "数值轴标题", "label"], ["SHOW_NUMBERS", "右侧写出数值", "bool"]]},
  {"id": "energy_profile", "name": "反应能垒图", "purpose": "catalysis", "size": [100, 66],
   "when": "反应路径上各中间态和过渡态的能量，几种表面或机理对比。",
   "data": "一列状态（按反应顺序）、一列能量，可选一列路径名。",
   "fields": [["STATE", "状态", "text"], ["ENERGY", "能量", "number"], ["PATHWAY", "路径（可不选）", "text?"],
              ["YLABEL", "纵轴标题", "label"], ["SHOW_VALUES", "标出每级能量", "bool"]]},
  {"id": "area", "name": "堆叠面积图 / 河流图", "purpose": "trend", "size": [100, 62],
   "when": "几个组成部分随时间或条件的变化，看总量和各部分的消长；可换成百分比或河流图。",
   "data": "一列横轴数值、一列系列名、一列数值（每个系列每个横轴值一行）。",
   "fields": [["X", "横轴数值", "number"], ["SERIES", "系列（颜色）", "text"], ["Y", "数值", "number"],
              ["PERCENT", "换算成百分比", "bool"], ["STREAM", "河流图（以零为中线）", "bool"],
              ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"], ["LABEL_INSIDE", "名称写在色带里", "bool"]]},
  {"id": "donut", "name": "环形图 / 饼图", "purpose": "compose", "size": [80, 62],
   "when": "一个总量由少数几部分组成（不超过六七项），看各占多少；洞的大小设为 0 就是饼图。",
   "data": "一列名称、一列数值。",
   "fields": [["LABEL", "名称", "text"], ["VALUE", "数值", "number"], ["HOLE", "中间洞的大小（0 = 饼图）", "float"],
              ["SHOW_PERCENT", "标出百分比", "bool"], ["SORT", "从大到小排", "bool"], ["CENTER_TEXT", "洞里的文字", "label"],
              ["HIGHLIGHT_ITEM", "突出显示的一块", "value:LABEL"]]},
  {"id": "radar", "name": "雷达图", "purpose": "multivar", "size": [92, 70],
   "when": "几个对象在多项指标上的综合表现，比如候选催化剂的活性、稳定性、成本等打分。",
   "data": "一列对象、一列指标、一列分数（每个对象每项指标一行）。",
   "fields": [["ITEM", "对象（每个一圈）", "text"], ["AXIS", "指标（每项一根轴）", "text"], ["VALUE", "分数", "number"],
              ["FILL", "填充颜色", "bool"], ["MAX", "最外圈数值（0 = 自动）", "float"],
              ["HIGHLIGHT_ITEM", "突出显示的对象", "value:ITEM"]]},
  {"id": "ridgeline", "name": "山脊图", "purpose": "distribution", "size": [89, 70],
   "when": "很多组的分布并排比较（比如不同温度下的速率分布），比叠在一起的直方图清楚。",
   "data": "一列分组、一列测量值（每行一次测量）。",
   "fields": [["GROUP", "分组（每组一道山脊）", "text"], ["VALUE", "测量值", "number"], ["OVERLAP", "山脊重叠程度", "float"],
              ["BANDWIDTH", "平滑程度（0 = 自动）", "float"], ["XLABEL", "横轴标题", "label"], ["SHOW_MEDIAN", "标出中位数", "bool"]]},
  {"id": "raincloud", "name": "云雨图", "purpose": "distribution", "size": [89, 66],
   "when": "分布形状、箱线和每个数据点放在一张图上，样本数中等时最诚实。",
   "data": "一列分组、一列测量值（每行一次测量）。",
   "fields": [["GROUP", "分组", "text"], ["VALUE", "测量值", "number"], ["XLABEL", "数值轴标题", "label"],
              ["BANDWIDTH", "平滑程度（0 = 自动）", "float"]]},
  {"id": "density", "name": "密度曲线", "purpose": "distribution", "size": [89, 62],
   "when": "一个量的分布用平滑曲线表示，几组叠在一起比较，比如模型误差和基线误差。",
   "data": "一列数值，可选一列分组。",
   "fields": [["VALUE", "数值", "number"], ["GROUP", "分组（可不选）", "text?"], ["FILL", "曲线下填色", "bool"],
              ["BANDWIDTH", "平滑程度（0 = 自动）", "float"], ["SHOW_RUG", "在轴上标出每个值", "bool"],
              ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"]]},
  {"id": "bubble", "name": "气泡图", "purpose": "relation", "size": [100, 70],
   "when": "两个量的关系再加第三个量（气泡大小），比如成本、活性和产能。",
   "data": "三列数值（横轴、纵轴、大小），可选一列分组和一列名称。",
   "fields": [["X", "横轴数值", "number"], ["Y", "纵轴数值", "number"], ["SIZE", "气泡大小", "number"],
              ["GROUP", "分组（可不选）", "text?"], ["LABEL", "名称（可不选）", "text?"], ["XLABEL", "横轴标题", "label"],
              ["YLABEL", "纵轴标题", "label"], ["SIZE_TITLE", "气泡大小图例标题", "label"], ["MAX_AREA", "最大气泡面积", "float"]]},
  {"id": "corr_heatmap", "name": "相关性热图", "purpose": "multivar", "size": [92, 80],
   "when": "很多描述符两两之间的相关系数，一眼看出哪些量相关、哪些冗余。",
   "data": "宽表：每列一个变量（数值），每行一个样本。",
   "fields": [["COLUMNS", "参与的列（逗号分隔，空 = 全部数值列）", "label"],
              ["METHOD", "相关系数", "choice:pearson=Pearson（线性）,spearman=Spearman（秩）"],
              ["LOWER_ONLY", "只画下三角", "bool"], ["SHOW_VALUES", "格子里标数值", "bool"],
              ["CMAP", "配色", "choice:RdBu_r=蓝白红,coolwarm=冷暖,PuOr_r=紫橙,BrBG=棕绿"], ["COLORBAR_LABEL", "色条标题", "label"]]},
  {"id": "dual_y", "name": "双 Y 轴图", "purpose": "trend", "size": [100, 66],
   "when": "同一横轴上两个量纲不同的量，比如转化率和选择性随温度变化。",
   "data": "一列横轴数值、两列纵轴数值。",
   "fields": [["X", "横轴数值", "number"], ["Y1", "左轴数值", "number"], ["Y2", "右轴数值", "number"],
              ["XLABEL", "横轴标题", "label"], ["Y1LABEL", "左轴标题", "label"], ["Y2LABEL", "右轴标题", "label"],
              ["Y1_BARS", "左轴画成柱子", "bool"], ["MARKERS", "画数据点", "bool"]]},
  {"id": "pareto", "name": "帕累托图", "purpose": "rank", "size": [100, 66],
   "when": "找出贡献最大的少数几项：柱子从大到小，折线是累计占比。",
   "data": "一列名称、一列数值。",
   "fields": [["LABEL", "名称", "text"], ["VALUE", "数值", "number"], ["XLABEL", "横轴标题", "label"],
              ["YLABEL", "纵轴标题", "label"], ["SHOW_80", "标出 80 % 线", "bool"]]},
  {"id": "diverging_bar", "name": "正负偏差条形图", "purpose": "compare", "size": [100, 66],
   "when": "各因素让结果变好或变坏多少，比如敏感性分析中每个参数的影响。",
   "data": "一列名称、一列有正有负的数值。",
   "fields": [["LABEL", "名称", "text"], ["VALUE", "数值（正负）", "number"], ["SORT", "排序", "bool"],
              ["POSITIVE_GOOD", "正值用主色、负值用红色", "bool"], ["XLABEL", "数值轴标题", "label"],
              ["SHOW_VALUES", "标出数值", "bool"], ["VALUE_FORMAT", "数值格式", "label"]]},
  {"id": "polar_bar", "name": "玫瑰图 / 环形柱状图", "purpose": "compare", "size": [80, 80],
   "when": "有周期的一组量（月份、方位、时段），或想把很多类别排成一圈。",
   "data": "一列名称、一列数值。",
   "fields": [["LABEL", "名称", "text"], ["VALUE", "数值", "number"], ["SORT", "从大到小排", "bool"],
              ["INNER", "中心空白（0 = 从圆心起）", "float"], ["SHOW_VALUES", "标出数值", "bool"],
              ["HIGHLIGHT_ITEM", "突出显示的一项", "value:LABEL"]]},
  {"id": "contour", "name": "等高线图", "purpose": "relation", "size": [100, 72],
   "when": "一个量随两个条件的变化面，比如速率随温度和压力，找最优区域。",
   "data": "三列数值：横轴、纵轴和该点的值（网格或散点都行）。",
   "fields": [["X", "横轴数值", "number"], ["Y", "纵轴数值", "number"], ["Z", "该点的值", "number"],
              ["LEVELS", "颜色分级数", "int"], ["CMAP", "配色", "choice:viridis=viridis,cividis=cividis,magma=magma,Blues=蓝,RdBu_r=蓝白红"],
              ["SHOW_LINES", "画等高线", "bool"], ["LABEL_LINES", "等高线上标数值", "bool"], ["SHOW_POINTS", "标出数据点", "bool"],
              ["MARK_MAX", "标出最大值", "bool"], ["XLABEL", "横轴标题", "label"], ["YLABEL", "纵轴标题", "label"],
              ["COLORBAR_LABEL", "色条标题", "label"]]},
  {"id": "treemap", "name": "矩形树图", "purpose": "compose", "size": [100, 66],
   "when": "很多项的组成（比如设备投资拆分），面积代表大小，可按大类着色。",
   "data": "一列名称、一列数值，可选一列大类。",
   "fields": [["LABEL", "名称", "text"], ["VALUE", "数值（面积）", "number"], ["GROUP", "大类（可不选）", "text?"],
              ["SHOW_VALUES", "标出数值", "bool"], ["VALUE_FORMAT", "数值格式", "label"]]},
  {"id": "waffle", "name": "华夫饼图", "purpose": "compose", "size": [90, 60],
   "when": "用 100 个小方块表示百分比构成，比饼图更容易数清。",
   "data": "一列名称、一列数值。",
   "fields": [["LABEL", "名称", "text"], ["VALUE", "数值", "number"], ["ROWS", "行数", "int"], ["COLS", "列数", "int"],
              ["SHOW_PERCENT", "图例里写百分比", "bool"]]},
  {"id": "venn", "name": "韦恩图（2–3 组）", "purpose": "sets", "size": [80, 72],
   "when": "两三种方法筛出的候选有多少重合，比如计算筛选、机器学习和文献的交集。",
   "data": "一列组名、一列对象名（某对象属于某组就写一行）。",
   "fields": [["SET", "组", "text"], ["ITEM", "对象", "text"], ["SHOW_PERCENT", "同时标出占比", "bool"]]},
  {"id": "upset", "name": "UpSet 交集图", "purpose": "sets", "size": [120, 72],
   "when": "四组以上的交集，韦恩图画不清时用；按交集大小排序。",
